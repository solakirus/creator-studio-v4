<?xml version="1.0" encoding="utf-8"?>
<!-- Day. Goes in: android/app/src/main/res/layout/cs_widget_small.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/cs_widget_bg" android:padding="10dp">
    <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Day 53" android:textColor="#FFEDE5D2" android:textSize="22sp" android:textStyle="bold" android:fontFamily="sans-serif-black" android:maxLines="1"/>
    <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12-day streak" android:textColor="#FFFDB37E" android:textSize="11.5sp" android:textStyle="bold" android:maxLines="1"/>
    <TextView android:id="@+id/w_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 of 5 done" android:textColor="#FFA9A395" android:textSize="12sp" android:maxLines="2" android:gravity="center"/>
</LinearLayout>
