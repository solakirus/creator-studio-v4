<?xml version="1.0" encoding="utf-8"?>
<!-- Up next. Goes in: android/app/src/main/res/layout/cs_widget.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/cs_widget_grad" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="UP NEXT · 2:30P" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.06" android:maxLines="1"/>
        <TextView android:id="@+id/w_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/cs_pill_dark" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="in 40 min" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Film the opener: kitchen" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" android:fontFamily="sans-serif-black" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Episode 7 · 0/6 shots" android:textColor="#EBFFFFFF" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:id="@+id/w_btns" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/w_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="@drawable/cs_pill_white" android:gravity="center" android:text="Start shooting" android:textColor="#FFA84B07" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_done" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="@drawable/cs_pill_dark" android:gravity="center" android:text="Done" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
