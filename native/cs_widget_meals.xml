    </LinearLayout>
    <LinearLayout android:id="@+id/w_mrow4" android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_mslot4" android:layout_width="74dp" android:layout_height="wrap_content" android:text="Breakfast" android:textColor="#FFA9A395" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/>
