    </LinearLayout>
    <TextView android:id="@+id/w_mprep" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Meal prep at 4P · 4 meals" android:textColor="#FFF2C230" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" android:visibility="gone"/>
</LinearLayout>
