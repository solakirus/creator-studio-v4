<?xml version="1.0" encoding="utf-8"?>
<!-- Filming today. Goes in: android/app/src/main/res/layout/cs_widget_shoot.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/cs_widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/cs_ic_film"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="FILMING TODAY" android:textColor="#FFA9A395" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginStart="6dp"/>
        <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Day 53" android:textColor="#FFA9A395" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/w_shoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2 of 9 shots got" android:textColor="#FFEDE5D2" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-black" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
    <LinearLayout android:id="@+id/w_frow1" android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_ftitle1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Opener · kitchen" android:textColor="#FFEDE5D2" android:textSize="13.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_fcount1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/6" android:textColor="#FFF2C230" android:textSize="12.5sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/w_frow2" android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_ftitle2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Opener · kitchen" android:textColor="#FFEDE5D2" android:textSize="13.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_fcount2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/6" android:textColor="#FFF2C230" android:textSize="12.5sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/w_frow3" android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_ftitle3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Opener · kitchen" android:textColor="#FFEDE5D2" android:textSize="13.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/w_fcount3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/6" android:textColor="#FFF2C230" android:textSize="12.5sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
