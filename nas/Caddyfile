# Creator Studio v4 on nastime — the web app for the iPad (and any browser).
#
# Serves the built web app (www/, from update.bat / publish-nas, or pulled
# from GitHub by the mirror) and passes Sync
# calls through to Sync Hub, so the app and its sync share one address: the
# iPad's Safari never has to reach a second server (or plain http from https).
#
#   http://192.168.4.23:8795                       at home, no Tailscale
#   https://nastime.<your-tailnet>.ts.net          anywhere, via `tailscale serve`
#
# SYNC_HUB is where Sync Hub listens, seen from inside this container.

{
	admin off
}

:80 {
	encode gzip

	# Sync Hub, on the same address as the app
	@sync path /sync/* /stats /health
	handle @sync {
		reverse_proxy {$SYNC_HUB:host.docker.internal:8787}
	}

	handle {
		root * /site/www
		# the page, the service worker and the build manifest are always asked
		# for fresh, so a new publish reaches the iPad the next time it opens
		@fresh path / /index.html /sw.js /update.json /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		# the phone app downloads updates from here too (from its own
		# https://localhost page), so every file may be read across origins
		header Access-Control-Allow-Origin "*"
		file_server
	}
}
